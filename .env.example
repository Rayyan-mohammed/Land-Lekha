# copy to .env and adjust. Never commit the real .env.
LL_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# POSTGRES_PASSWORD=change-me   # required by docker-compose.yml when using Postgres
# LL_DATABASE_URL=postgresql+psycopg://landlekha:password@localhost:5432/landlekha
# LL_STORAGE_DIR=storage
# LL_AUTO_ACCEPT_THRESHOLD=0.90   # default: threshold chosen by eval/calibrate.py
# LL_OCR_ENGINE=easyocr
# --- OCR tuning; the defaults are the measured ones (eval/results/experiments.md) ---
# LL_OCR_CANVAS=1280              # text-detection canvas in px; smaller is faster and less accurate
# LL_OCR_DENOISE_H=12             # denoising strength of the first read
# LL_OCR_RETRY_SOFT=1             # read a page again with lighter denoising when it reads badly
# LL_OCR_RETRY_DENOISE_H=5        # denoising strength of that second read
# LL_OCR_SHARPEN=0                # unsharp mask on soft pages (tried, no gain in field accuracy)
# LL_OCR_TABLE_CELLS=0            # read Khatauni tables cell by cell (tried, slightly worse today)
# LL_OCR_NUMBER_PASS=1            # read unsure Latin-digit numbers again with an english-only recogniser
# LL_OCR_NUMBER_MAX_CONF=0.5      # only tokens the main model is this unsure about
# LL_OCR_NUMBER_MIN_GAIN=0.15     # and only when the second reading is this much more confident
# LL_MAX_UPLOAD_MB=20
# LL_MAX_IMAGE_PIXELS=60000000    # refuse images that decode larger than this (60 MP)
# LL_SEED_DEMO_USERS=1            # creates admin / verifier / operator demo accounts on first start
# LL_CORS_ORIGINS=http://localhost:5173

# notifications (backend/api/notifications.py) - console-only until one of these is set
# LL_SMTP_HOST=smtp.example.com
# LL_SMTP_PORT=587
# LL_SMTP_USER=
# LL_SMTP_PASSWORD=
# LL_SMTP_FROM=noreply@landlekha.local
# LL_NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...   # or any JSON-accepting SMS/push gateway
